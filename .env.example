# Copy this file to ".env" and edit it. Never share or commit your .env file.

# Port of the local server
MIHWAR_PORT=8090

# Optional: switch on Claude (LLM mode). Leave "off" to run fully offline (the default).
MIHWAR_LLM=off
# Your Anthropic API key goes here only if you switch LLM mode on:
# ANTHROPIC_API_KEY=
# MIHWAR_MODEL=claude-opus-5-5

# Seconds between animated steps in the live demo scenario
MIHWAR_SCENARIO_DELAY=0.6
